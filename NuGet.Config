<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only use the local machine cache — no network calls -->
    <clear />
    <add key="nuget-local-cache" value="%USERPROFILE%\.nuget\packages" />
  </packageSources>

  <packageSourceMapping>
    <!-- Map all packages to the local cache -->
    <packageSource key="nuget-local-cache">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Disable all online vulnerability / audit checks -->
  <config>
    <add key="auditSources" value="" />
  </config>
</configuration>
