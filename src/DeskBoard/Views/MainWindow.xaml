<Window x:Class="DeskBoard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBoard"
        Width="300"
        MinWidth="210" MaxWidth="390"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Topmost="False"
        Loaded="Window_Loaded"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <!-- Outer container with padding so drop shadow doesn't clip + ScaleTransform for dynamic resizing -->
    <Grid Margin="12">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="BoardScale" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <!-- Root Frosted Glass Card -->
        <Border x:Name="RootCard"
                CornerRadius="16"
                BorderThickness="1"
                ClipToBounds="True">
            <!-- Glass Background -->
            <Border.Background>
                <SolidColorBrush Color="#D410141D"/>
            </Border.Background>
            <!-- Specular Top-lit Border -->
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#45FFFFFF" Offset="0"/>
                    <GradientStop Color="#18FFFFFF" Offset="0.3"/>
                    <GradientStop Color="#0DFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <!-- Deep ambient drop shadow -->
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <!-- Subtle top specular gradient sheen -->
                <Border Height="55" VerticalAlignment="Top" CornerRadius="16,16,0,0" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#12FFFFFF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Edge Resize Strips for easy border grabbing -->
                <Border Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Cursor="SizeWE" Background="Transparent" Panel.ZIndex="10"
                        MouseLeftButtonDown="ResizeGrip_MouseDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseUp"/>
                <Border Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Cursor="SizeNS" Background="Transparent" Panel.ZIndex="10"
                        MouseLeftButtonDown="ResizeGrip_MouseDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseUp"/>

                <StackPanel x:Name="MainContainer">

                    <!-- ══════════════════════════════════════
                         DRAG HANDLE (Top subtle pill)
                    ══════════════════════════════════════ -->
                    <Border Height="14" Cursor="SizeAll"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown"
                            Background="Transparent"
                            ToolTip="Click and drag to move DeskBoard">
                        <Border Width="32" Height="3.5"
                                CornerRadius="2"
                                Background="#35FFFFFF"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                    </Border>

                    <!-- ══════════════════════════════════════
                         HEADER: "Todo · N"  +  [+] Button
                    ══════════════════════════════════════ -->
                    <Border x:Name="HeaderBar"
                            Padding="16,2,12,8"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown"
                            Background="Transparent">
                        <Grid>
                            <!-- Left: Title and Count -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Todo"
                                           FontSize="13.5"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFFFF"
                                           FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI, sans-serif"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" · "
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#60FFFFFF"
                                           FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI, sans-serif"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TaskCountText"
                                           Text="0"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="#A0FFFFFF"
                                           FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI, sans-serif"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Right: Settings gear + Plus/Close circle button -->
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Settings Icon Button -->
                                <Border x:Name="SettingsBtn"
                                        Width="24" Height="24"
                                        CornerRadius="12"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        Margin="0,0,6,0"
                                        ToolTip="Settings"
                                        MouseLeftButtonDown="OpenSettings_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="1.0"/>
                                                    <Setter Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="⚙"
                                               FontSize="12"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Circular Plus / Close Button (rotates to ✕) -->
                                <Border x:Name="AddToggleBtn"
                                        Width="26" Height="26"
                                        CornerRadius="13"
                                        BorderThickness="1"
                                        BorderBrush="#38FFFFFF"
                                        Background="#18FFFFFF"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="AddToggleBtn_Click"
                                        ToolTip="Add Task">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2EFFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <!-- Vector Icon: Rotates 45deg from '+' to '✕' -->
                                    <Canvas Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="PlusIconRotate" Angle="0" CenterX="6" CenterY="6"/>
                                        </Canvas.RenderTransform>
                                        <!-- Vertical bar of '+' -->
                                        <Path Data="M 6,1 L 6,11"
                                              Stroke="White"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                        <!-- Horizontal bar of '+' -->
                                        <Path Data="M 1,6 L 11,6"
                                              Stroke="White"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══════════════════════════════════════
                         ADD TASK PANEL (Slides down smoothly)
                    ══════════════════════════════════════ -->
                    <Border x:Name="AddPanel"
                            Visibility="Collapsed"
                            Padding="14,4,14,12">
                        <StackPanel>
                            <!-- Input Box -->
                            <Border CornerRadius="8"
                                    Height="36"
                                    Background="#1A2230"
                                    BorderBrush="#25FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,0,8">
                                <Grid Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pencil Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="✏"
                                               FontSize="11"
                                               Foreground="#70FFFFFF"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <!-- Placeholder Text -->
                                    <TextBlock Grid.Column="1"
                                               x:Name="PlaceholderText"
                                               Text="Add a task..."
                                               FontSize="12"
                                               Foreground="#55FFFFFF"
                                               FontFamily="Segoe UI"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>

                                    <!-- Real Input Box -->
                                    <TextBox Grid.Column="1"
                                             x:Name="TitleInput"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             CaretBrush="White"
                                             FontSize="12"
                                             FontFamily="Segoe UI"
                                             VerticalAlignment="Center"
                                             TextChanged="TitleInput_TextChanged"
                                             KeyDown="TitleInput_KeyDown"/>
                                </Grid>
                            </Border>

                            <!-- Segmented Tabs: [✓ Simple task]  [↺ Recurring task] -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Simple Task Tab -->
                                <Border x:Name="SimpleTab"
                                        Grid.Column="0"
                                        CornerRadius="7"
                                        Height="32"
                                        Cursor="Hand"
                                        Background="#263042"
                                        BorderBrush="#38FFFFFF"
                                        BorderThickness="1"
                                        MouseLeftButtonDown="SimpleTab_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✓ " FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock Text="Simple task" FontSize="11" FontWeight="Medium" Foreground="White" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>

                                <!-- Recurring Task Tab -->
                                <Border x:Name="RecurringTab"
                                        Grid.Column="2"
                                        CornerRadius="7"
                                        Height="32"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderBrush="#18FFFFFF"
                                        BorderThickness="1"
                                        MouseLeftButtonDown="RecurringTab_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="↺ " FontSize="11" Foreground="#75FFFFFF"/>
                                        <TextBlock x:Name="RecurringTabText" Text="Recurring task" FontSize="11" FontWeight="Normal" Foreground="#75FFFFFF" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ── Recurring Options (Shown when Recurring tab is active) ── -->
                            <StackPanel x:Name="RecurringSection" Visibility="Collapsed" Margin="0,0,0,10">
                                <!-- Row 1: Repeat -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="↺ " FontSize="11" Foreground="#70FFFFFF" Margin="0,0,4,0"/>
                                        <TextBlock Text="Repeat" FontSize="11" Foreground="#95FFFFFF" FontFamily="Segoe UI"/>
                                    </StackPanel>

                                    <!-- Dropdown Pill -->
                                    <Border x:Name="RepeatDropdownBtn"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            CornerRadius="7"
                                            Background="#1E2738"
                                            BorderBrush="#25FFFFFF"
                                            BorderThickness="1"
                                            Padding="12,5"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="RepeatDropdownBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="RepeatLabel" Text="Weekly" FontSize="11" Foreground="White" FontFamily="Segoe UI"/>
                                            <TextBlock Text="  ⌄" FontSize="10" Foreground="#70FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- INLINE Repeat Dropdown Card (Never disappears or loses focus) -->
                                <Border x:Name="RepeatOptionsCard"
                                        Visibility="Collapsed"
                                        CornerRadius="9"
                                        Background="#F0131924"
                                        BorderBrush="#35FFFFFF"
                                        BorderThickness="1"
                                        Margin="0,2,0,8"
                                        Padding="4">
                                    <StackPanel>
                                        <Border Padding="10,6" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                MouseLeftButtonDown="RepeatOption_Click" Tag="Weekly">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="OptWeeklyText" Text="✓  Weekly" FontSize="11" Foreground="White" FontFamily="Segoe UI"/>
                                        </Border>
                                        <Border Padding="10,6" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                MouseLeftButtonDown="RepeatOption_Click" Tag="Monthly">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="OptMonthlyText" Text="    Monthly" FontSize="11" Foreground="White" FontFamily="Segoe UI"/>
                                        </Border>
                                        <Border Padding="10,6" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                MouseLeftButtonDown="RepeatOption_Click" Tag="Yearly">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="OptYearlyText" Text="    Yearly" FontSize="11" Foreground="White" FontFamily="Segoe UI"/>
                                        </Border>
                                        <Border Padding="10,6" CornerRadius="6" Cursor="Hand" Background="Transparent"
                                                MouseLeftButtonDown="RepeatOption_Click" Tag="Daily">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#25FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock x:Name="OptDailyText" Text="    Daily" FontSize="11" Foreground="White" FontFamily="Segoe UI"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Row 2: Start Date -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📅 " FontSize="11" Foreground="#70FFFFFF" Margin="0,0,4,0"/>
                                        <TextBlock Text="Start date" FontSize="11" Foreground="#95FFFFFF" FontFamily="Segoe UI"/>
                                    </StackPanel>

                                    <!-- Date Pill -->
                                    <Border x:Name="DateBtn"
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            CornerRadius="7"
                                            Background="#1E2738"
                                            BorderBrush="#25FFFFFF"
                                            BorderThickness="1"
                                            Padding="12,5"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="DateBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="DateLabel" Text="Nov 02, 2026" FontSize="11" Foreground="White" FontFamily="Segoe UI"/>
                                            <TextBlock Text="  ⌄" FontSize="10" Foreground="#70FFFFFF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Recurrence Summary Text (Confirms exact day/schedule) -->
                                <TextBlock x:Name="RecurrenceSummaryText"
                                           Text="Repeats every week on Monday"
                                           FontSize="10"
                                           Foreground="#85A78BFA"
                                           FontFamily="Segoe UI"
                                           Margin="0,2,0,4"/>

                                <!-- Custom Glass Calendar Inline Card -->
                                <Border x:Name="CalendarPopupCard"
                                        Visibility="Collapsed"
                                        CornerRadius="10"
                                        Background="#EE141A26"
                                        BorderBrush="#35FFFFFF"
                                        BorderThickness="1"
                                        Margin="0,4,0,0"
                                        Padding="10,8">
                                    <StackPanel>
                                        <!-- Month Header with navigation -->
                                        <Grid Margin="0,0,0,6">
                                            <Border Width="20" Height="20" CornerRadius="10"
                                                    Background="#20FFFFFF" HorizontalAlignment="Left"
                                                    Cursor="Hand" MouseLeftButtonDown="CalPrevMonth_Click">
                                                <TextBlock Text="‹" FontSize="13" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                            </Border>
                                            <TextBlock x:Name="CalMonthLabel" Text="November 2026"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="White" FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Border Width="20" Height="20" CornerRadius="10"
                                                    Background="#20FFFFFF" HorizontalAlignment="Right"
                                                    Cursor="Hand" MouseLeftButtonDown="CalNextMonth_Click">
                                                <TextBlock Text="›" FontSize="13" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                            </Border>
                                        </Grid>

                                        <!-- Day Names Header -->
                                        <UniformGrid Columns="7" Margin="0,0,0,4">
                                            <TextBlock Text="Su" FontSize="9" Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Mo" FontSize="9" Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Tu" FontSize="9" Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="We" FontSize="9" Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Th" FontSize="9" Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Fr" FontSize="9" Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Sa" FontSize="9" Foreground="#55FFFFFF" HorizontalAlignment="Center"/>
                                        </UniformGrid>

                                        <!-- Days Grid (Populated dynamically) -->
                                        <UniformGrid x:Name="CalDaysGrid" Columns="7"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Cancel and Add Task Action Buttons -->
                            <Grid Margin="0,4,0,0">
                                <!-- Cancel Text Button -->
                                <TextBlock Text="Cancel"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#85FFFFFF"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Cursor="Hand"
                                           Padding="4,4"
                                           MouseLeftButtonDown="CancelBtn_Click"/>

                                <!-- White Apple-Style "Add Task" Button -->
                                <Border x:Name="ConfirmAddBtn"
                                        HorizontalAlignment="Right"
                                        Background="White"
                                        CornerRadius="7"
                                        Padding="16,6"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="ConfirmAddBtn_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E6E6E6"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Add Task"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#0D1117"
                                               FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>

                            <!-- Inline "✓ Added" feedback -->
                            <TextBlock x:Name="InlineFeedback"
                                       Text="✓ Task added"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       Foreground="#86EFAC"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"
                                       Visibility="Collapsed"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Hairline separator before task list -->
                    <Rectangle x:Name="ListSeparator"
                               Height="1"
                               Margin="14,0"
                               Opacity="0.10"
                               Visibility="Visible">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="White" Offset="0.3"/>
                                <GradientStop Color="White" Offset="0.7"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- ══════════════════════════════════════
                         TASK LIST (Exactly 4 items visible, scrollable)
                    ══════════════════════════════════════ -->
                    <ScrollViewer x:Name="TaskScroller"
                                  Height="130"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12,4,12,6"
                                  PreviewMouseWheel="TaskScroller_PreviewMouseWheel">
                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Task Row Container -->
                                    <Border CornerRadius="6"
                                            Padding="4,5"
                                            Margin="0,0,0,2"
                                            Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0DFFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Col 0: Task content (Checkbox + Title) -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Col 1: Delete Button (Fixed right alignment for all rows!) -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Content Sub-Grid: Indented right when completed, leaving delete button locked in place! -->
                                            <Grid Grid.Column="0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Margin" Value="0,0,6,0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Task.IsCompleted}" Value="True">
                                                                <Setter Property="Margin" Value="10,0,6,0"/>
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Circular Apple/iOS-style Checkbox with Pop Animation -->
                                                <Border Grid.Column="0"
                                                        x:Name="CheckCircle"
                                                        Width="18" Height="18"
                                                        CornerRadius="9"
                                                        BorderThickness="1.5"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        Margin="0,0,9,0"
                                                        VerticalAlignment="Center"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        MouseLeftButtonDown="TaskCheckbox_Click"
                                                        Tag="{Binding .}">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                    </Border.RenderTransform>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#95FFFFFF"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding Task.IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <!-- Crisp Vector Checkmark with Scale Origin -->
                                                    <Canvas Width="10" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Canvas.RenderTransform>
                                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                        </Canvas.RenderTransform>
                                                        <Canvas.Style>
                                                            <Style TargetType="Canvas">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Opacity" Value="0.0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Task.IsCompleted}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Canvas.Style>
                                                        <Path Data="M 1,4.2 L 3.8,7 L 9,1.5"
                                                              Stroke="White"
                                                              StrokeThickness="1.8"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"/>
                                                    </Canvas>
                                                </Border>

                                                <!-- Task Title: Bold, Modern Typography -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Task.Title}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI, sans-serif"
                                                           Foreground="#F8FAFC"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Task.IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Foreground" Value="#50FFFFFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Delete Button (Col 1: Always in exact same right position across all rows!) -->
                                            <Border Grid.Column="1"
                                                    Width="15" Height="15"
                                                    CornerRadius="7.5"
                                                    Background="#20FFFFFF"
                                                    BorderBrush="#30FFFFFF"
                                                    BorderThickness="1"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="6,0,0,0"
                                                    Opacity="0.70"
                                                    MouseLeftButtonDown="DeleteTask_Click"
                                                    Tag="{Binding .}"
                                                    ToolTip="Delete task">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                <Setter Property="Background" Value="#E0EF4444"/>
                                                                <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="×"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Margin="0,-1.5,0,0"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </StackPanel>

                <!-- Corner Resize Grip (Bottom-right, perfectly visible & draggable) -->
                <Border Width="18" Height="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Cursor="SizeNWSE"
                        Background="Transparent"
                        ToolTip="Drag to resize board"
                        MouseLeftButtonDown="ResizeGrip_MouseDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseUp"
                        Margin="0,0,2,2"
                        Panel.ZIndex="20">
                    <Path Data="M 11,5 L 5,11 M 11,8 L 8,11"
                          Stroke="#38FFFFFF"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
