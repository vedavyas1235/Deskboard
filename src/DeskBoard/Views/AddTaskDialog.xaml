<Window x:Class="DeskBoard.Views.AddTaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Task"
        Width="420" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Tab indicator animation -->
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <!-- Root container -->
    <Border CornerRadius="20" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E80D1117" Offset="0"/>
                <GradientStop Color="#E8111827" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#55FFFFFF" Offset="0"/>
                <GradientStop Color="#15FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.7" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with close -->
            <Grid Grid.Row="0" Margin="24,22,24,0">
                <TextBlock Text="New Task"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Foreground="#EEFFFFFF"
                          FontFamily="Segoe UI"
                          VerticalAlignment="Center"/>
                <Button Content="✕"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Width="28" Height="28"
                       Click="Close_Click"
                       Style="{StaticResource GlassIconButtonStyle}"
                       FontSize="11"/>
            </Grid>

            <!-- Tab selector: Regular | Scheduled -->
            <Grid Grid.Row="1" Margin="24,18,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="TabRegular"
                       Grid.Column="0"
                       CornerRadius="12"
                       Padding="0,10"
                       Cursor="Hand"
                       MouseLeftButtonDown="TabRegular_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#18FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#28FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TabRegularIcon" Text="📋" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TabRegularText"
                                  Text="Regular"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  Foreground="#AAFFFFFF"
                                  FontFamily="Segoe UI"
                                  HorizontalAlignment="Center"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border x:Name="TabScheduled"
                       Grid.Column="2"
                       CornerRadius="12"
                       Padding="0,10"
                       Cursor="Hand"
                       MouseLeftButtonDown="TabScheduled_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#18FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="#20FFFFFF"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#28FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Animated clock face -->
                        <Canvas Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <!-- Clock circle -->
                            <Ellipse Width="22" Height="22" Canvas.Left="0" Canvas.Top="0"
                                    Stroke="#80A78BFA" StrokeThickness="1.5" Fill="Transparent"/>
                            <!-- Hour hand -->
                            <Line x:Name="HourHand"
                                 X1="11" Y1="11" X2="11" Y2="6"
                                 Stroke="#C0A78BFA" StrokeThickness="2"
                                 StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                                <Line.RenderTransform>
                                    <RotateTransform x:Name="HourHandRotate" Angle="0" CenterX="0" CenterY="5"/>
                                </Line.RenderTransform>
                            </Line>
                            <!-- Minute hand -->
                            <Line x:Name="MinuteHand"
                                 X1="11" Y1="11" X2="11" Y2="4"
                                 Stroke="#EEA78BFA" StrokeThickness="1.5"
                                 StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Line.RenderTransform>
                                    <RotateTransform x:Name="MinuteHandRotate" Angle="0" CenterX="0" CenterY="7"/>
                                </Line.RenderTransform>
                            </Line>
                            <!-- Center dot -->
                            <Ellipse Width="4" Height="4" Canvas.Left="9" Canvas.Top="9" Fill="#A78BFA"/>
                        </Canvas>
                        <TextBlock x:Name="TabScheduledText"
                                  Text="Scheduled"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  Foreground="#AAFFFFFF"
                                  FontFamily="Segoe UI"
                                  HorizontalAlignment="Center"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Content panels (Regular / Scheduled) -->
            <StackPanel x:Name="ContentPanel" Grid.Row="2" Margin="24,20,24,0" Opacity="1">

                <!-- Task title (shared) -->
                <TextBlock Text="Task title"
                          FontSize="11"
                          FontWeight="Medium"
                          Foreground="#80FFFFFF"
                          FontFamily="Segoe UI"
                          Margin="0,0,0,6"/>
                <TextBox x:Name="TitleInput"
                        Style="{StaticResource GlassTextBoxStyle}"
                        Height="40"
                        Margin="0,0,0,14"
                        KeyDown="TitleInput_KeyDown"/>

                <!-- Description (shared) -->
                <TextBlock Text="Description  (optional)"
                          FontSize="11"
                          FontWeight="Medium"
                          Foreground="#80FFFFFF"
                          FontFamily="Segoe UI"
                          Margin="0,0,0,6"/>
                <TextBox x:Name="DescInput"
                        Style="{StaticResource GlassTextBoxStyle}"
                        Height="40"
                        Margin="0,0,0,14"/>

                <!-- Recurring options (visible only in Scheduled mode) -->
                <StackPanel x:Name="RecurringPanel" Visibility="Collapsed">
                    <!-- Separator -->
                    <Rectangle Height="1" Margin="0,2,0,16" Opacity="0.1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="White" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Frequency label + ComboBox -->
                    <TextBlock Text="Recurrence frequency"
                              FontSize="11"
                              FontWeight="Medium"
                              Foreground="#80FFFFFF"
                              FontFamily="Segoe UI"
                              Margin="0,0,0,6"/>
                    <ComboBox x:Name="FrequencyCombo"
                             Height="40"
                             Margin="0,0,0,14"
                             Style="{StaticResource GlassComboBoxStyle}">
                        <ComboBoxItem Content="Daily"   IsSelected="True"/>
                        <ComboBoxItem Content="Weekly"/>
                        <ComboBoxItem Content="Monthly"/>
                        <ComboBoxItem Content="Yearly"/>
                    </ComboBox>

                    <!-- Start Date -->
                    <TextBlock Text="Start date"
                              FontSize="11"
                              FontWeight="Medium"
                              Foreground="#80FFFFFF"
                              FontFamily="Segoe UI"
                              Margin="0,0,0,6"/>
                    <DatePicker x:Name="StartDatePicker"
                               Height="40"
                               Margin="0,0,0,6"
                               Foreground="White"
                               Background="#18FFFFFF"
                               BorderBrush="#35FFFFFF"
                               BorderThickness="1"/>

                    <!-- Live date display -->
                    <Border Background="#15A78BFA"
                           BorderBrush="#30A78BFA"
                           BorderThickness="1"
                           CornerRadius="10"
                           Padding="12,8"
                           Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏰  "
                                      FontSize="12"
                                      Foreground="#A78BFA"
                                      VerticalAlignment="Center"/>
                            <TextBlock x:Name="ScheduleSummary"
                                      Text="Every day from today"
                                      FontSize="11"
                                      FontWeight="Medium"
                                      Foreground="#C0A78BFA"
                                      FontFamily="Segoe UI"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Action buttons -->
            <Grid Grid.Row="3" Margin="24,20,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                       Content="Cancel"
                       Click="Close_Click"
                       Style="{StaticResource GhostButtonStyle}"
                       Height="42"/>

                <Button x:Name="AddButton"
                       Grid.Column="2"
                       Content="Add Task"
                       Click="AddTask_Click"
                       Style="{StaticResource PrimaryButtonStyle}"
                       Height="42"/>
            </Grid>
        </Grid>
    </Border>
</Window>
