<Window x:Class="DeskBoard.Views.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="260" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border CornerRadius="14" BorderThickness="1" Padding="16,12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E00D1117" Offset="0"/>
                <GradientStop Color="#E0111827" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#50FFFFFF" Offset="0"/>
                <GradientStop Color="#15FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Margin="0,0,10,0" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A78BFA" Offset="0"/>
                        <GradientStop Color="#6C63FF" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.9" Color="#A78BFA"/>
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock x:Name="MessageText"
                      FontSize="12"
                      FontFamily="Segoe UI"
                      Foreground="#DDFFFFFF"
                      TextWrapping="Wrap"
                      VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
