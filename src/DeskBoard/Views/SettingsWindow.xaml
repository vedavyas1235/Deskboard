<Window x:Class="DeskBoard.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskBoard Settings"
        Height="500" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Loaded="Window_Loaded">

    <Border CornerRadius="18" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F00D1117" Offset="0"/>
                <GradientStop Color="#F0111827" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#44FFFFFF" Offset="0"/>
                <GradientStop Color="#12FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.7" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="22,18,22,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6C63FF" Offset="0"/>
                                    <GradientStop Color="#A78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="⚙" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#EEFFFFFF" FontFamily="Segoe UI"/>
                            <TextBlock Text="Configure DeskBoard" FontSize="11" FontWeight="Light"
                                       Foreground="#55FFFFFF" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="26" Height="26" Click="Cancel_Click"
                            Style="{StaticResource GlassIconButtonStyle}" FontSize="10"/>
                </Grid>
            </Border>

            <!-- Hairline -->
            <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="22,0" Opacity="0.1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="White" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16,22,8">
                <StackPanel>

                    <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold"
                               Foreground="#44FFFFFF" FontFamily="Segoe UI" Margin="0,0,0,10"/>

                    <!-- Always on Top -->
                    <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="16,12" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Always on Top" FontSize="13" FontWeight="Medium"
                                           Foreground="#DDFFFFFF" FontFamily="Segoe UI"/>
                                <TextBlock Text="Float above all other windows (Off: stick to desktop)"
                                           FontSize="11" Foreground="#55FFFFFF" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="AlwaysOnTopCheck"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Settings.AlwaysOnTop}"/>
                        </Grid>
                    </Border>

                    <!-- Start with Windows -->
                    <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="16,12" Margin="0,0,0,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Start with Windows" FontSize="13" FontWeight="Medium"
                                           Foreground="#DDFFFFFF" FontFamily="Segoe UI"/>
                                <TextBlock Text="Launch DeskBoard automatically on startup"
                                           FontSize="11" Foreground="#55FFFFFF" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="StartupCheck"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Settings.StartWithWindows}"
                                      Click="StartupCheck_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="DATA" FontSize="10" FontWeight="Bold"
                               Foreground="#44FFFFFF" FontFamily="Segoe UI" Margin="0,0,0,10"/>

                    <!-- Auto Backup -->
                    <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="16,12" Margin="0,0,0,6">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Auto Backup" FontSize="13" FontWeight="Medium"
                                           Foreground="#DDFFFFFF" FontFamily="Segoe UI"/>
                                <TextBlock Text="Periodically back up your tasks"
                                           FontSize="11" Foreground="#55FFFFFF" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding Settings.AutoBackup}"/>
                        </Grid>
                    </Border>

                    <!-- Create Backup Now -->
                    <Border CornerRadius="10" Height="38" Cursor="Hand" Margin="0,0,0,16"
                            MouseLeftButtonDown="CreateBackup_Click">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1A6C63FF" Offset="0"/>
                                <GradientStop Color="#1AA78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#336C63FF"/>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>
                        <TextBlock Text="📦  Create Backup Now"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="#BBA78BFA" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- ══════════════════════════════════════
                         RECURRING TASKS SECTION
                    ══════════════════════════════════════ -->
                    <TextBlock Text="RECURRING SCHEDULES" FontSize="10" FontWeight="Bold"
                               Foreground="#44FFFFFF" FontFamily="Segoe UI" Margin="0,4,0,10"/>

                    <!-- Empty state -->
                    <Border x:Name="NoRecurringTasksCard"
                            Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="16,14" Margin="0,0,0,10"
                            Visibility="Collapsed">
                        <TextBlock Text="No recurring tasks scheduled yet. Add one from the '+' panel on DeskBoard!"
                                   FontSize="11" Foreground="#55FFFFFF" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>

                    <!-- Recurring tasks list -->
                    <ItemsControl x:Name="RecurringTasksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#10FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Schedule Info -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#EEFFFFFF" FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="↺ " FontSize="10" Foreground="#85A78BFA"/>
                                                <TextBlock Text="{Binding ScheduleDescription}" FontSize="11"
                                                           Foreground="#85A78BFA" FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Delete Button -->
                                        <Border Grid.Column="1"
                                                Width="26" Height="26"
                                                CornerRadius="13"
                                                Background="#18FFFFFF"
                                                BorderBrush="#25FFFFFF"
                                                BorderThickness="1"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                MouseLeftButtonDown="DeleteRecurringTemplate_Click"
                                                Tag="{Binding Id}"
                                                ToolTip="Delete recurring schedule completely">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E0EF4444"/>
                                                            <Setter Property="BorderBrush" Value="#FF6B6B"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="×" FontSize="13" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="22,12,22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="9" BorderBrush="#25FFFFFF"
                            BorderThickness="1" Height="38" Cursor="Hand"
                            MouseLeftButtonDown="Cancel_Click2">
                        <TextBlock Text="Cancel" FontSize="12" FontWeight="Medium"
                                   Foreground="#88FFFFFF" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="9" Width="140" Height="38" Cursor="Hand"
                            MouseLeftButtonDown="Save_Click2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#6C63FF" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="Save Settings" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White" FontFamily="Segoe UI"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
